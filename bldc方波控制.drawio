        <mxCell id="pwr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Consolas;" value="上电复位&#xa;crt0 启动：堆栈设置 / 用户 RAM 清零" vertex="1">
          <mxGeometry height="40" width="230" x="260" y="-7" as="geometry" />
