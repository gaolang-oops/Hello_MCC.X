        <mxCell id="init1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Consolas;" value="&lt;font color=&quot;#0066CC&quot;&gt;SYSTEM_Initialize()&lt;/font&gt;&#xa;MCC 外设初始化（Clock / GPIO / PWM / ADC / UART2 / IC / TMR3）&#xa;└ 末尾已开全局中断&#xa;&lt;font color=&quot;#0066CC&quot;&gt;SelfCheck_Report()&lt;/font&gt;&#xa;立即调用：频率/配对自检 VERIFY(阻断) + printf 报告" vertex="1">
          <mxGeometry height="45" width="280" x="235" y="63" as="geometry" />
        </mxCell>
        <mxCell id="init2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontFamily=Consolas;" value="&lt;font color=&quot;#0066CC&quot;&gt;INTERRUPT_GlobalDisable()&lt;/font&gt;&#xa;BSP 初始化（中断关闭期间，禁用 printf）：&#xa;&lt;font color=&quot;#0066CC&quot;&gt;GPIO_Configure_LEDS&lt;/font&gt; / &lt;font color=&quot;#0066CC&quot;&gt;KEYS&lt;/font&gt;&#xa;&lt;font color=&quot;#0066CC&quot;&gt;BSP_Timer_Init&lt;/font&gt; / &lt;font color=&quot;#0066CC&quot;&gt;BSP_ICx_HW_Init&lt;/font&gt;&#xa;&lt;font color=&quot;#0066CC&quot;&gt;BSP_ADC_Int_Register&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="280" x="235" y="138" as="geometry" />
        </mxCell>
        <mxCell id="init3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontFamily=Consolas;" value="应用初始化：&#xa;&lt;font color=&quot;#0066CC&quot;&gt;UartLframe_Init&lt;/font&gt; / &lt;font color=&quot;#0066CC&quot;&gt;MCProtocol_Init&lt;/font&gt;（RX 回调）&#xa;&lt;font color=&quot;#0066CC&quot;&gt;MCButton_Init&lt;/font&gt;（按键消抖）&#xa;&lt;font color=&quot;#0066CC&quot;&gt;Motor_Init&lt;/font&gt;（Ramp / SIXSTEP / HALL / MC_Fault）&#xa;&lt;font color=&quot;#0066CC&quot;&gt;MCFaultIndicator_Init&lt;/font&gt;（LED3 故障指示）" vertex="1">
          <mxGeometry height="109" width="280" x="235" y="260" as="geometry" />
