        <mxCell id="init4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontFamily=Consolas;" value="&lt;font color=&quot;#0066CC&quot;&gt;INTERRUPT_GlobalEnable()&lt;/font&gt;&lt;br&gt;printf 自检报告（时钟源 / IRQ 优先级 / PWM 配置）&lt;br&gt;&lt;font color=&quot;#0066CC&quot;&gt;Delay_ms(500)&lt;/font&gt;  等模拟信号稳定&lt;div&gt;//读取电机静止状态下的初始模拟量值&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="235" y="390" as="geometry" />
        </mxCell>
        <mxCell id="loop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Consolas;" value="while(1)  主循环" vertex="1">
          <mxGeometry height="30" width="170" x="290" y="490" as="geometry" />
