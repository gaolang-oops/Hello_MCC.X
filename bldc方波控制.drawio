        <mxCell id="isr_title" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=14;fontFamily=Consolas;" value="中断服务（并发，按优先级）" vertex="1">
          <mxGeometry height="30" width="200" x="640" y="10" as="geometry" />
        </mxCell>
        <mxCell id="isr_ic" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Consolas;" value="IC1/2/3 ISR（优先级 7）── Tier-0 事件驱动&lt;br&gt;Hall 边沿捕捉 → &lt;font color=&quot;#0066CC&quot;&gt;HALL_OnIsr&lt;/font&gt;：&lt;br&gt;  1. &lt;font color=&quot;#0066CC&quot;&gt;HALL_UpdateInputState()&lt;/font&gt;  去抖(3次) / 合法态 / 变化检测&lt;br&gt;  2. 非法态(000/111) 连续确认 N=3 → &lt;font color=&quot;#0066CC&quot;&gt;MC_SetFault(HALL_INVALID)&lt;/font&gt;&lt;br&gt;  3. 记边沿 ms 时戳（供 HALL_TIMEOUT 检测）&lt;br&gt;  4. &lt;font color=&quot;#0066CC&quot;&gt;&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;调用观察者&lt;/span&gt;s_on_edge(hall_status)&lt;/font&gt;[six_step注册]&amp;nbsp;→&amp;nbsp;&lt;br&gt;&lt;div&gt;&lt;font color=&quot;#0066CC&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;执行注册函数：&lt;/span&gt;SIXSTEP_OnHallEdge&lt;/font&gt;&lt;br&gt;     → &lt;font color=&quot;#0066CC&quot;&gt;SIXSTEP_Communicate()&lt;/font&gt;  查表换相(&lt;font color=&quot;#0066CC&quot;&gt;PWM_SetPhaseMode&lt;/font&gt; ×3)&lt;br&gt;     → &lt;font color=&quot;#0066CC&quot;&gt;MC_NotifyCommutation()&lt;/font&gt;  启动 blanking 屏蔽期&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="480" x="620" y="50" as="geometry" />
        </mxCell>
        <mxCell id="isr_adc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Consolas;" value="ADC1 ISR（优先级 6）── Tier-1  50μs（与 PWM 硬件同步）&lt;br&gt;1. 采样：CH1~3 常驻 Ia/Ib/Ic（每周期）+ CH0 轮询 Vbus/Knob/Ibus&lt;br&gt;2. SMA 滤波（Vbus / Knob）&lt;br&gt;3. 时基分频 → 50μs tick / 1ms flag / 500ms flag&lt;br&gt;4. &lt;font color=&quot;#0066CC&quot;&gt;MC_OverCurrentCheck()&lt;/font&gt;（50μs 回调）：&lt;br&gt;   &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;blanking 期内跳过；否则 raw 与预计算阈值比较（零运行时换算）&lt;br&gt;   &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;过流 → &lt;font color=&quot;#0066CC&quot;&gt;SIXSTEP_Enable(false)&lt;/font&gt; ISR 内立即硬关 PWM + &lt;font color=&quot;#0066CC&quot;&gt;MC_SetFault&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="480" x="620" y="210" as="geometry" />
        </mxCell>
        <mxCell id="isr_tmr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Consolas;" value="TMR3 ISR（优先级 5）&#xa;10μs 软件 tick → &lt;font color=&quot;#0066CC&quot;&gt;Delay10us&lt;/font&gt; / &lt;font color=&quot;#0066CC&quot;&gt;NowMs&lt;/font&gt;&#xa;独立秒表：延时 / 时间戳（不参与控制节拍）" vertex="1">
          <mxGeometry height="60" width="480" x="620" y="350" as="geometry" />
        </mxCell>
        <mxCell id="isr_uart" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Consolas;" value="UART2 ISR（TX=3 / RX=2 / ERR=1）&#xa;环形缓冲收发 → &lt;font color=&quot;#0066CC&quot;&gt;UartLframe_Process&lt;/font&gt; 轮询消费" vertex="1">
          <mxGeometry height="45" width="480" x="620" y="430" as="geometry" />
        </mxCell>
        <mxCell id="e_isr1" edge="1" parent="1" source="init4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;curved=1;fontFamily=Consolas;" target="isr_ic" value="开中断后 ISR 生效">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_isr2" edge="1" parent="1" source="isr_adc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;fontFamily=Consolas;" target="f1ms" value="置 1ms/&lt;div&gt;500ms flag&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="330" />
              <mxPoint x="580" y="620" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sm_title" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=14;fontFamily=Consolas;" value="Motor_Tick 状态机（1ms，Tier-2）" vertex="1">
          <mxGeometry height="30" width="250" x="280" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="sm_entry" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Consolas;" value="每拍前置：&#xa;① L2 慢保护（&lt;font color=&quot;#0066CC&quot;&gt;CheckVoltage&lt;/font&gt; / &lt;font color=&quot;#0066CC&quot;&gt;CheckOverload&lt;/font&gt; / &lt;font color=&quot;#0066CC&quot;&gt;CheckHall&lt;/font&gt;）&#xa;② cmd = s_command; s_command = NONE（一次性命令快照，消费即清零）&#xa;③ 预分流：&lt;font color=&quot;#0066CC&quot;&gt;MC_HasAnyFault()&lt;/font&gt; → 强制 FAULT；cmd==STOP → 强制 STOPPED" vertex="1">
          <mxGeometry height="70" width="470" x="170" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="sm_fault" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Consolas;" value="FAULT&#xa;故障吸收态&#xa;&lt;font color=&quot;#0066CC&quot;&gt;SIXSTEP_Enable(false)&lt;/font&gt;&#xa;&lt;font color=&quot;#0066CC&quot;&gt;Ramp_ForceZero&lt;/font&gt;&#xa;拒绝任何启动" vertex="1">
          <mxGeometry height="80" width="160" x="60" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="sm_stopped" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Consolas;" value="STOPPED&#xa;正常停机&#xa;&lt;font color=&quot;#0066CC&quot;&gt;SIXSTEP_Enable(false)&lt;/font&gt;&#xa;&lt;font color=&quot;#0066CC&quot;&gt;Ramp_ForceZero&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="160" x="300" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="sm_boot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Consolas;" value="BOOTSTRAP&#xa;瞬态&#xa;&lt;font color=&quot;#0066CC&quot;&gt;PWM_HighOffLowOn()&lt;/font&gt;&#xa;三相下管常通" vertex="1">
          <mxGeometry height="80" width="150" x="570" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="sm_charging" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Consolas;" value="CHARGING&#xa;稳态&#xa;等待 50ms&#xa;自举电容充电" vertex="1">
          <mxGeometry height="80" width="150" x="775" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="sm_ready" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Consolas;" value="READY&#xa;就绪待速&#xa;&lt;font color=&quot;#0066CC&quot;&gt;PWM_AllOff&lt;/font&gt; 后等旋钮&#xa;30s 超时 → STOPPED" vertex="1">
          <mxGeometry height="80" width="160" x="770" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="sm_running" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Consolas;" value="RUNNING&#xa;&lt;font color=&quot;#0066CC&quot;&gt;MC_Ramp_Step()&lt;/font&gt; 缓变&#xa;Hall ISR → 六步换相&#xa;旋钮=0 缓停 → READY" vertex="1">
          <mxGeometry height="80" width="170" x="414" y="1320" as="geometry" />
        </mxCell>
