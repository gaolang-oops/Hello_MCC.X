        <mxCell id="t4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontFamily=Consolas;" value="Tier-4（每轮）：&#xa;&lt;font color=&quot;#0066CC&quot;&gt;UartLframe_Process()&lt;/font&gt;  帧解析&#xa;&lt;font color=&quot;#0066CC&quot;&gt;MCProtocol_PollFault()&lt;/font&gt;  故障边沿推送" vertex="1">
